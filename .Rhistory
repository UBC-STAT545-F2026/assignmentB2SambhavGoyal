library(assignmentB2SambhavGoyal)
# Use the penguins dataset for the example
penguins<- palmerpenguins::penguins
penguins_scaled <- penguins |>
mutate(
Original = flipper_length_mm,
Min_Max = min_max_transform(flipper_length_mm),
Z_Score = z_transform(flipper_length_mm),
Log_Min_Max = log_min_max_transform(flipper_length_mm)
) |>
select(species, Original, Min_Max, Z_Score, Log_Min_Max)
library(assignmentB2SambhavGoyal)
# Use the penguins dataset for the example
penguins<- palmerpenguins::penguins
penguins_scaled <- penguins |>
dplyr::mutate(
Original = flipper_length_mm,
Min_Max = min_max_transform(flipper_length_mm),
Z_Score = z_transform(flipper_length_mm),
Log_Min_Max = log_min_max_transform(flipper_length_mm)
) |>
dplyr::select(species, Original, Min_Max, Z_Score, Log_Min_Max)
penguins_long <- penguins_scaled |>
dplyr::pivot_longer(
cols = c(Original, Min_Max, Z_Score, Log_Min_Max),
names_to = "Transformation",
values_to = "Value"
)
library(assignmentB2SambhavGoyal)
# Use the penguins dataset for the example
penguins<- palmerpenguins::penguins
penguins_scaled <- penguins |>
dplyr::mutate(
Original = flipper_length_mm,
Min_Max = min_max_transform(flipper_length_mm),
Z_Score = z_transform(flipper_length_mm),
Log_Min_Max = log_min_max_transform(flipper_length_mm)
) |>
dplyr::select(species, Original, Min_Max, Z_Score, Log_Min_Max)
penguins_long <- penguins_scaled |>
tidyr::pivot_longer(
cols = c(Original, Min_Max, Z_Score, Log_Min_Max),
names_to = "Transformation",
values_to = "Value"
)
# Lets find prices after the scaling
# assignmentB2SambhavGoyal::min_max_transform(product_prices, replaceNA = TRUE)
penguins_long |>
ggplot(aes(x = Value)) +
geom_histogram(
bins = 25,
fill = "steelblue",
color = "white"
) +
facet_wrap(
~ Transformation,
scales = "free_x",
ncol = 2
) +
labs(
title = "Comparison of Numerical Transformations",
subtitle = "Flipper length of Palmer Penguins",
x = "Transformed Flipper Length",
y = "Frequency"
) +
theme_minimal()
